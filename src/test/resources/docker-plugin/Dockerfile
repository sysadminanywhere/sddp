FROM alpine:3.20
RUN printf '#!/bin/sh\nif grep -q root-test "$1"; then touch /root/write-test 2>/dev/null || exit 11; fi\nif grep -q flood-test "$1"; then head -c 200000 /dev/zero | tr "\\000" x >&2; exit 7; fi\nif grep -q many-test "$1"; then i=0; while [ "$i" -lt 510 ]; do : > "$2/$i"; i=$((i+1)); done; exit 0; fi\nif grep -q link-test "$1"; then ln -s /etc/passwd "$2/link"; exit 0; fi\nif grep -q disk-test "$1"; then dd if=/dev/zero of="$2/large" bs=1048576 count=20 2>/dev/null || exit 9; fi\nif grep -q fail-test "$1"; then echo "fixture plugin failed" >&2; exit 7; fi\ncp "$1" "$2/result.json"\n' > /usr/local/bin/plugin && chmod 755 /usr/local/bin/plugin
